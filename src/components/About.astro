---
import { business } from '../config/business';
---

<section class="section pb-0 md:pb-0">
  <div class="grid gap-8 md:grid-cols-5 md:items-center md:gap-12">
    <div class="md:col-span-3">
      <p class="eyebrow">Welcome</p>
      <h2 class="section-title">{business.aboutTitle ?? `About ${business.name}`}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink/75">{business.description}</p>
    </div>
    {
      business.highlights?.length ? (
        <ul class="grid grid-cols-2 gap-3 md:col-span-2">
          {business.highlights.map((h) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-4 text-sm font-semibold shadow-sm">
              <span class="mb-2 block h-1.5 w-8 rounded-full bg-brand" />
              {h}
            </li>
          ))}
        </ul>
      ) : null
    }
  </div>
</section>
