---
import { business } from '../config/business';
import { telHref } from '../lib/utils';
import Icon from './Icon.astro';

const links = [
  { href: '#menu', label: 'Menu' },
  { href: '#hours', label: 'Hours' },
  { href: '#visit', label: 'Visit' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-cream/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="#top" class="font-display truncate text-lg font-semibold text-ink sm:text-xl">{business.name}</a>

    <nav class="hidden items-center gap-7 text-sm font-medium md:flex" aria-label="Main">
      {links.map((l) => <a href={l.href} class="text-ink/70 transition hover:text-brand">{l.label}</a>)}
      <a href={telHref} class="btn-primary py-2.5"><Icon name="phone" class="h-4 w-4" /> {business.phone}</a>
    </nav>

    <details class="group relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-ink/15 bg-white [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <Icon name="menu" />
      </summary>
      <nav
        class="absolute right-0 mt-2 w-48 overflow-hidden rounded-2xl border border-ink/10 bg-white py-2 shadow-xl"
        aria-label="Mobile"
      >
        {links.map((l) => <a href={l.href} class="block px-4 py-2.5 text-sm font-medium hover:bg-cream">{l.label}</a>)}
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the mobile <details> menu after tapping a link.
  document.querySelectorAll('header details nav a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>
