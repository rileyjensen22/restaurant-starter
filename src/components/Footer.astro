---
import { business } from '../config/business';
import { DAYS, formatRanges, fullAddress, telHref, mailHref } from '../lib/utils';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-white/80">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-8 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl font-semibold text-white">{business.name}</p>
      <p class="mt-3 text-sm text-white/60">{business.tagline}</p>
      {
        business.social.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-3">
            {business.social.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener"
                  class="rounded-full border border-white/20 px-3 py-1.5 text-xs font-medium hover:border-accent hover:text-accent"
                >
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="text-sm">
      <p class="font-semibold text-white">Visit</p>
      <p class="mt-3">{fullAddress}</p>
      <p class="mt-2"><a href={telHref} class="hover:text-accent">{business.phone}</a></p>
      <p class="mt-1"><a href={mailHref} class="hover:text-accent">{business.email}</a></p>
    </div>
    <div class="text-sm">
      <p class="font-semibold text-white">Hours</p>
      <ul class="mt-3 space-y-1">
        {
          DAYS.map((d) => (
            <li class="flex justify-between gap-4">
              <span>{d.label.slice(0, 3)}</span>
              <span class="text-right text-white/60">{formatRanges(business.hours[d.key])}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-6 text-xs text-white/50 sm:flex-row sm:justify-between sm:px-8">
      <p>&copy; {year} {business.name}. All rights reserved.</p>
      {business.demoMode && <p class="font-semibold text-accent">Sample content: demo template, fictional business.</p>}
    </div>
  </div>
</footer>
