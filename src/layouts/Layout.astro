---
import '../styles/global.css';
import { business } from '../config/business';
import { absoluteUrl } from '../lib/utils';
import { buildRestaurantSchema, serializeJsonLd } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${business.name} | ${business.cuisine.join(' & ')} in ${business.address.city}, ${business.address.region}`,
  description = business.description,
} = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(business.ogImage);
const jsonLd = serializeJsonLd(buildRestaurantSchema());
const c = business.colors;
const brandVars = `--brand-primary:${c.primary};--brand-primary-contrast:${c.primaryContrast};--brand-accent:${c.accent};--brand-dark:${c.dark};--brand-light:${c.light};`;
---

<!doctype html>
<html lang="en" style={brandVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={business.favicon} />
    <meta name="theme-color" content={c.dark} />
    <meta name="format-detection" content="telephone=no" />
    {business.demoMode && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" as="image" href={business.hero.image} />

    <!-- schema.org Restaurant (LocalBusiness) generated from src/config/business.ts -->
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <slot />
  </body>
</html>
